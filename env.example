# =====================================================================
# MessMate backend — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database (Railway injects this automatically once Postgres is attached) ---
DATABASE_URL=postgresql://username:password@localhost:5432/messmate

# --- JWT ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email (Gmail SMTP — use a 16-char App Password, not your login password) ---
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your-16-char-app-password

# --- CORS — the origin your frontend is served from ---
CLIENT_URL=http://localhost:3000

# --- Upload limits (mirror register.js on the frontend) ---
MAX_IMAGE_MB=5
MAX_PDF_MB=8
MAX_MESS_PHOTOS=6
